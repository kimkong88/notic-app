# Notic API base URL (optional). Default: https://api.getnotic.io
# Use for local backend, e.g. http://localhost:3002
# VITE_API_URL=https://api.getnotic.io

# Google OAuth 2.0 client ID for "Sign in with Google" (SPA).
# Create in Google Cloud Console: APIs & Services → Credentials → Create OAuth 2.0 Client ID → Web application.
# Add authorized JavaScript origins (e.g. http://localhost:5173, https://your-app.com).
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Chrome Extension ID for extension detection via externally_connectable.
# Find in chrome://extensions after loading the extension.
# VITE_EXTENSION_ID=your-extension-id

# Microsoft Clarity project ID (analytics/heatmaps).
# Only loaded in production (non-localhost). Get from https://clarity.microsoft.com
# VITE_CLARITY_ID=your-clarity-project-id
